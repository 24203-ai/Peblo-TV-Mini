POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/peblo_mini
SECRET_KEY=your_secure_jwt_secret_key

# --- Production Secrets Management ---
# In a real-world production environment, these secrets would NEVER be committed to source control 
# or managed as raw text files. Instead, they would be injected at runtime using a secure secrets 
# manager such as AWS Secrets Manager, HashiCorp Vault, or Google Secret Manager. 
# For CI/CD pipelines, they would be stored securely in GitHub Actions Secrets and injected as 
# environment variables during the deployment phase.
